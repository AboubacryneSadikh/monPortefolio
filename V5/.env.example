# ─────────────────────────────────────────────
#  G2-AWS-P2026 — Backend — Variables d'environnement
#  Copiez ce fichier en .env et remplissez vos valeurs
# ─────────────────────────────────────────────

# URL de connexion MongoDB Atlas
# Format : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/g2_aws_portfolio?retryWrites=true&w=majority

# Port du serveur Express (défaut : 3001)
PORT=3001

# Origine autorisée pour le CORS (frontend React)
FRONTEND_URL=http://localhost:5173
