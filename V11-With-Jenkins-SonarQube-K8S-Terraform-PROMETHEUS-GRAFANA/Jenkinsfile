pipeline {
    agent any

    // ─── PARAMÈTRES : cocher une ou les deux cibles ───────────────────────────
    parameters {
        booleanParam(
            name: 'DEPLOY_LOCAL',
            defaultValue: true,
            description: 'Déployer sur Kubernetes local (Minikube)'
        )
        booleanParam(
            name: 'DEPLOY_AWS',
            defaultValue: true,
            description: 'Déployer sur AWS EKS via Terraform'
        )
        booleanParam(
            name: 'DESTROY_AWS',
            defaultValue: false,
            description: '⚠️  DESTROY — Détruire toute l\'infra AWS (02-app puis 01-infra). Désactive les déploiements.'
        )
        booleanParam(
            name: 'DESTROY_LOCAL',
            defaultValue: false,
            description: '⚠️  DESTROY — Supprimer tous les objets Kubernetes locaux (namespace portfolio)'
        )
        string(
            name: 'IMAGE_TAG_OVERRIDE',
            defaultValue: '',
            description: 'Tag Docker à forcer (laisser vide = build-${BUILD_NUMBER})'
        )
    }

    environment {
        DOCKERHUB_CREDENTIALS     = credentials('dockerhub-credentials')
        DOCKERHUB_USERNAME        = "${DOCKERHUB_CREDENTIALS_USR}"
        BACKEND_IMAGE             = "${DOCKERHUB_USERNAME}/portfolio-backend"
        FRONTEND_IMAGE            = "${DOCKERHUB_USERNAME}/portfolio-frontend"
        IMAGE_TAG                 = "${params.IMAGE_TAG_OVERRIDE ?: "build-${BUILD_NUMBER}"}"
        K8S_NAMESPACE             = "portfolio"
        K8S_DIR                   = "${WORKSPACE}/V10-With-Jenkins-SonarQube-K8S-Terraform/k8s"
        TF_DIR_APP                = "${WORKSPACE}/V10-With-Jenkins-SonarQube-K8S-Terraform/terraform/02-app"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
        timeout(time: 90, unit: 'MINUTES')
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    stages {

        // ─── 0. CHECKOUT ────────────────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[url: 'https://github.com/AboubacryneSadikh/monPortefolio.git']],
                    extensions: [[$class: 'WipeWorkspace']]
                ])
            }
        }

        // ─── 1. BUILD DOCKER ────────────────────────────────────────────────
        stage('Build Images Docker') {
            parallel {
                stage('Build Backend') {
                    steps {
                        sh """
                            docker build \
                                -t ${BACKEND_IMAGE}:${IMAGE_TAG} \
                                -t ${BACKEND_IMAGE}:latest \
                                ${WORKSPACE}/V10-With-Jenkins-SonarQube-K8S-Terraform/backend
                        """
                    }
                }
                stage('Build Frontend') {
                    steps {
                        sh """
                            docker build \
                                -t ${FRONTEND_IMAGE}:${IMAGE_TAG} \
                                -t ${FRONTEND_IMAGE}:latest \
                                ${WORKSPACE}/V10-With-Jenkins-SonarQube-K8S-Terraform/frontend
                        """
                    }
                }
            }
        }

        // ─── 2. TEST ────────────────────────────────────────────────────────
        stage('Test conteneurs') {
            steps {
                sh """
                    docker run -d --name test-backend-${BUILD_NUMBER} \
                        -e PORT=5000 \
                        -e MONGODB_URI=mongodb://localhost:27017/test \
                        -e NODE_ENV=test \
                        ${BACKEND_IMAGE}:${IMAGE_TAG}
                    sleep 10
                    docker inspect test-backend-${BUILD_NUMBER} --format='{{.State.Status}}' | grep -q running
                    echo 'Backend container OK'
                """
            }
            post {
                always {
                    sh """
                        docker stop test-backend-${BUILD_NUMBER} 2>/dev/null || true
                        docker rm   test-backend-${BUILD_NUMBER} 2>/dev/null || true
                    """
                }
            }
        }

        // ─── 3. PUSH DOCKERHUB ──────────────────────────────────────────────
        stage('Push Docker Hub') {
            steps {
                sh 'echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin'
                retry(3) { sh "docker push ${BACKEND_IMAGE}:${IMAGE_TAG}" }
                retry(3) { sh "docker push ${BACKEND_IMAGE}:latest" }
                retry(3) { sh "docker push ${FRONTEND_IMAGE}:${IMAGE_TAG}" }
                retry(3) { sh "docker push ${FRONTEND_IMAGE}:latest" }
            }
            post {
                always { sh 'docker logout' }
            }
        }

        // ─── 4. DESTROY EN PARALLÈLE (si demandé) ───────────────────────────
        stage('Destroy') {
            when {
                expression { params.DESTROY_AWS == true || params.DESTROY_LOCAL == true }
            }
            parallel {

                // ─── 4a. DESTROY LOCAL ───────────────────────────────────────
                stage('Destroy Local (Minikube)') {
                    when {
                        expression { params.DESTROY_LOCAL == true }
                    }
                    steps {
                        sh """
                            echo "=== ⚠️  DESTROY Kubernetes LOCAL ==="
                            kubectl delete namespace ${K8S_NAMESPACE} --ignore-not-found=true
                            echo "=== Namespace ${K8S_NAMESPACE} supprimé ==="
                        """
                    }
                    post {
                        success { echo "✅ Destroy LOCAL réussi — namespace ${K8S_NAMESPACE} supprimé" }
                        failure { echo "❌ Destroy LOCAL échoué" }
                    }
                }

                // ─── 4b. DESTROY AWS ─────────────────────────────────────────
                stage('Destroy AWS (Terraform)') {
                    when {
                        expression { params.DESTROY_AWS == true }
                    }
                    environment {
                        AWS_CREDENTIALS           = credentials('aws-credentials')
                        AWS_ACCESS_KEY_ID         = "${AWS_CREDENTIALS_USR}"
                        AWS_SECRET_ACCESS_KEY     = "${AWS_CREDENTIALS_PSW}"
                        TF_VAR_mongo_password     = credentials('mongo-password')
                        TF_VAR_backend_image_tag  = "${IMAGE_TAG}"
                        TF_VAR_frontend_image_tag = "${IMAGE_TAG}"
                    }
                    steps {
                        sh """
                            echo "=== ⚠️  DESTROY 02-app (K8S sur EKS) ==="
                            cd '${TF_DIR_APP}'
                            terraform init -input=false
                            terraform destroy -input=false -auto-approve

                            echo "=== ⚠️  DESTROY 01-infra (EKS + VPC) ==="
                            cd '${WORKSPACE}/V10-With-Jenkins-SonarQube-K8S-Terraform/terraform/01-infra'
                            terraform init -input=false
                            terraform destroy -input=false -auto-approve

                            echo "=== Infra AWS entièrement détruite ==="
                        """
                    }
                    post {
                        success { echo "✅ Destroy AWS réussi — EKS + VPC supprimés" }
                        failure { echo "❌ Destroy AWS échoué — vérifier l'état Terraform dans S3" }
                    }
                }

            } // fin parallel Destroy
        } // fin Destroy

        // ─── 5. DÉPLOIEMENTS EN PARALLÈLE ───────────────────────────────────
        stage('Deploy') {
            when {
                // Ne pas déployer si on est en mode Destroy
                expression { params.DESTROY_AWS == false && params.DESTROY_LOCAL == false }
            }
            parallel {

                // ─── 5a. LOCAL — Minikube / Kind ────────────────────────────
                stage('Deploy Local (Minikube)') {

    when {
        expression { params.DEPLOY_LOCAL == true }
    }

    environment {
        MONGO_PASSWORD = credentials('mongo-password')
    }

    steps {

        sh """

        echo "=== Déploiement sur Kubernetes LOCAL ==="

        echo "=== Vérification du dossier k8s ==="

        ls -la ${K8S_DIR}

        find ${K8S_DIR} -name "*mongodb*"



        echo "=== Informations Kubernetes ==="

        kubectl config current-context || true

        kubectl cluster-info || true

        kubectl get nodes || true



        echo "=== Mise à jour des images Docker ==="

        sed -i "s|image: ${DOCKERHUB_USERNAME}/portfolio-backend:.*|image: ${BACKEND_IMAGE}:${IMAGE_TAG}|g" \
            ${K8S_DIR}/backend-deployment.yaml

        sed -i "s|image: ${DOCKERHUB_USERNAME}/portfolio-frontend:.*|image: ${FRONTEND_IMAGE}:${IMAGE_TAG}|g" \
            ${K8S_DIR}/frontend-deployment.yaml



        echo "=== Génération du secret MongoDB ==="

        MONGO_USER_B64=\$(echo -n "mongo" | base64)

        MONGO_PASS_B64=\$(echo -n "\$MONGO_PASSWORD" | base64)

        sed "s|<BASE64_USERNAME>|\$MONGO_USER_B64|g; s|<BASE64_PASSWORD>|\$MONGO_PASS_B64|g" \
            ${K8S_DIR}/mongodb-secret.example.yaml \
            > ${K8S_DIR}/mongodb-secret.yaml



        echo "=== Application des manifests ==="

        kubectl apply -f ${K8S_DIR}/namespace.yaml

        kubectl apply -f ${K8S_DIR}/mongodb-secret.yaml

        kubectl apply -f ${K8S_DIR}/mongodb-service.yaml

        kubectl apply -f ${K8S_DIR}/mongodb-statefulset.yaml



        echo "=== Attente de MongoDB ==="

        kubectl rollout status statefulset/mongodb \
            -n ${K8S_NAMESPACE} \
            --timeout=300s



        echo "=== Déploiement Backend ==="

        kubectl apply -f ${K8S_DIR}/backend-service.yaml

        kubectl apply -f ${K8S_DIR}/backend-deployment.yaml



        echo "=== Attente Backend ==="

        kubectl rollout status deployment/backend \
            -n ${K8S_NAMESPACE} \
            --timeout=300s



        echo "=== Déploiement Frontend ==="

        kubectl apply -f ${K8S_DIR}/frontend-service.yaml

        kubectl apply -f ${K8S_DIR}/frontend-deployment.yaml



        echo "=== Attente Frontend ==="

        kubectl rollout status deployment/frontend \
            -n ${K8S_NAMESPACE} \
            --timeout=300s



        echo "=== Pods ==="

        kubectl get pods -n ${K8S_NAMESPACE}



        echo "=== Services ==="

        kubectl get svc -n ${K8S_NAMESPACE}



        echo "=== URL d'accès ==="

        echo "minikube service frontend-service -n ${K8S_NAMESPACE} --url"

        echo "ou"

        echo "kubectl port-forward svc/frontend-service 8080:80 -n ${K8S_NAMESPACE}"

        """
    }

    post {

        success {

            echo "✅ Déploiement LOCAL réussi — Build #${BUILD_NUMBER}"

        }

        failure {

            echo "❌ Déploiement LOCAL échoué — Build #${BUILD_NUMBER}"

            sh """

            echo "=== Diagnostic ==="

            kubectl get pods -n ${K8S_NAMESPACE} || true

            kubectl describe pods -n ${K8S_NAMESPACE} || true

            kubectl get events -n ${K8S_NAMESPACE} \
                --sort-by=.metadata.creationTimestamp || true

            kubectl logs deployment/backend \
                -n ${K8S_NAMESPACE} || true

            """

        }
    }
}

                // ─── 5b. AWS — EKS via Terraform ────────────────────────────
                stage('Deploy AWS (EKS + Terraform)') {
                    when {
                        expression { params.DEPLOY_AWS == true }
                    }
                    environment {
                        AWS_CREDENTIALS           = credentials('aws-credentials')
                        AWS_ACCESS_KEY_ID         = "${AWS_CREDENTIALS_USR}"
                        AWS_SECRET_ACCESS_KEY     = "${AWS_CREDENTIALS_PSW}"
                        TF_VAR_mongo_password     = credentials('mongo-password')
                        TF_VAR_backend_image_tag  = "${IMAGE_TAG}"
                        TF_VAR_frontend_image_tag = "${IMAGE_TAG}"
                    }
                    steps {
                        sh """
                            echo "=== Déploiement sur AWS EKS via Terraform ==="
                            cd '${TF_DIR_APP}'

                            echo "=== Terraform Init ==="
                            terraform init -input=false

                            echo "=== Terraform Plan ==="
                            terraform plan -input=false -out=tfplan-app

                            echo "=== Terraform Apply ==="
                            terraform apply -input=false -auto-approve tfplan-app

                            echo "=== URL Frontend (AWS LoadBalancer) ==="
                            terraform output frontend_url
                        """
                    }
                    post {
                        success { echo "✅ Déploiement AWS réussi — Build #${BUILD_NUMBER}" }
                        failure { echo "❌ Déploiement AWS échoué — Build #${BUILD_NUMBER}" }
                    }
                }

            } // fin parallel
        } // fin Deploy

    }

    // ─── POST GLOBAL ────────────────────────────────────────────────────────
    post {
        always {
            sh """
                docker rmi ${BACKEND_IMAGE}:${IMAGE_TAG} 2>/dev/null || true
                docker rmi ${FRONTEND_IMAGE}:${IMAGE_TAG} 2>/dev/null || true
                docker image prune -f || true
            """
        }
        success {
            echo "Pipeline réussi — Build #${BUILD_NUMBER} — Local:${params.DEPLOY_LOCAL} / AWS:${params.DEPLOY_AWS} / DestroyAWS:${params.DESTROY_AWS} / DestroyLocal:${params.DESTROY_LOCAL}"
            mail to: 'etablissementdinformatiqueacad@gmail.com',
                 subject: "[SUCCESS] Jenkins Build #${BUILD_NUMBER} — Portfolio",
                 body: """Pipeline terminé avec succès.

Build        : #${BUILD_NUMBER}
Deploy Local : ${params.DEPLOY_LOCAL}
Deploy AWS   : ${params.DEPLOY_AWS}
Destroy Local: ${params.DESTROY_LOCAL}
Destroy AWS  : ${params.DESTROY_AWS}
Branche      : ${env.GIT_BRANCH}
Image        : ${IMAGE_TAG}

Voir les logs : ${BUILD_URL}"""
        }
        failure {
            echo "Pipeline échoué — Build #${BUILD_NUMBER}"
            mail to: 'etablissementdinformatiqueacad@gmail.com',
                 subject: "[FAILURE] Jenkins Build #${BUILD_NUMBER} — Portfolio",
                 body: """Pipeline échoué.

Build        : #${BUILD_NUMBER}
Deploy Local : ${params.DEPLOY_LOCAL}
Deploy AWS   : ${params.DEPLOY_AWS}
Destroy Local: ${params.DESTROY_LOCAL}
Destroy AWS  : ${params.DESTROY_AWS}
Branche      : ${env.GIT_BRANCH}

Voir les logs : ${BUILD_URL}"""
        }
    }
}