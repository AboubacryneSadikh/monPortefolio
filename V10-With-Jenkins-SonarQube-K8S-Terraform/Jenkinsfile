pipeline {
    agent any

    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
        DOCKERHUB_USERNAME    = "${DOCKERHUB_CREDENTIALS_USR}"
        BACKEND_IMAGE         = "${DOCKERHUB_USERNAME}/portfolio-backend"
        FRONTEND_IMAGE        = "${DOCKERHUB_USERNAME}/portfolio-frontend"
        IMAGE_TAG             = "build-${BUILD_NUMBER}"
        K8S_NAMESPACE         = "portfolio"
        TF_DIR_INFRA          = "${WORKSPACE}/V10-With-Jenkins-SonarQube-K8S-Terraform/terraform/01-infra"
        TF_DIR_APP            = "${WORKSPACE}/V10-With-Jenkins-SonarQube-K8S-Terraform/terraform/02-app"
        AWS_CREDENTIALS       = credentials('aws-credentials')
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
        timeout(time: 90, unit: 'MINUTES')
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    stages {

        // ─── 0. CHECKOUT ────────────────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[url: 'https://github.com/AboubacryneSadikh/monPortefolio.git']],
                    extensions: [
                        [$class: 'CleanBeforeCheckout'],
                        [$class: 'CleanCheckout']
                    ]
                ])
            }
        }

        // ─── 1. BUILD DOCKER ────────────────────────────────────────────────
        stage('Build Images Docker') {
            parallel {
                stage('Build Backend') {
                    steps {
                        sh "docker build -t ${BACKEND_IMAGE}:${IMAGE_TAG} -t ${BACKEND_IMAGE}:latest ${WORKSPACE}/V10-With-Jenkins-SonarQube-K8S-Terraform/backend"
                    }
                }
                stage('Build Frontend') {
                    steps {
                        sh "docker build -t ${FRONTEND_IMAGE}:${IMAGE_TAG} -t ${FRONTEND_IMAGE}:latest ${WORKSPACE}/V10-With-Jenkins-SonarQube-K8S-Terraform/frontend"
                    }
                }
            }
        }

        // ─── 2. TEST ────────────────────────────────────────────────────────
        stage('Test conteneurs') {
            steps {
                sh """
                    docker run -d --name test-backend \
                        -e PORT=5000 \
                        -e MONGODB_URI=mongodb://localhost:27017/test \
                        -e NODE_ENV=test \
                        -p 5001:5000 \
                        ${BACKEND_IMAGE}:${IMAGE_TAG}
                    sleep 10
                    docker inspect test-backend --format='{{.State.Status}}' | grep -q running
                    echo 'Backend container OK'
                """
            }
            post {
                always {
                    sh 'docker stop test-backend 2>/dev/null || true; docker rm test-backend 2>/dev/null || true'
                }
            }
        }

        // ─── 3. PUSH DOCKERHUB ──────────────────────────────────────────────
        stage('Push Docker Hub') {
            when {
                expression {
                    return env.GIT_BRANCH == 'origin/main' ||
                           env.GIT_BRANCH == 'origin/master' ||
                           env.BRANCH_NAME == 'main' ||
                           env.BRANCH_NAME == 'master'
                }
            }
            steps {
                sh 'echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin'
                retry(3) { sh "docker push ${BACKEND_IMAGE}:${IMAGE_TAG}" }
                retry(3) { sh "docker push ${BACKEND_IMAGE}:latest" }
                retry(3) { sh "docker push ${FRONTEND_IMAGE}:${IMAGE_TAG}" }
                retry(3) { sh "docker push ${FRONTEND_IMAGE}:latest" }
            }
            post {
                always { sh 'docker logout' }
            }
        }

        // ─── 4. TERRAFORM — INFRASTRUCTURE (VPC + EKS) ──────────────────────
        stage('Terraform Infra') {
            when {
                expression {
                    return env.GIT_BRANCH == 'origin/main' ||
                           env.GIT_BRANCH == 'origin/master' ||
                           env.BRANCH_NAME == 'main' ||
                           env.BRANCH_NAME == 'master'
                }
            }
            environment {
                AWS_ACCESS_KEY_ID     = "${AWS_CREDENTIALS_USR}"
                AWS_SECRET_ACCESS_KEY = "${AWS_CREDENTIALS_PSW}"
                TF_VAR_mongo_password = credentials('mongo-password')
            }
            steps {
                sh """
                    cd '${TF_DIR_INFRA}'

                    echo "=== Terraform Init ==="
                    terraform init -input=false

                    echo "=== Terraform Plan ==="
                    terraform plan -input=false -out=tfplan-infra

                    echo "=== Terraform Apply ==="
                    terraform apply -input=false -auto-approve tfplan-infra
                """
            }
        }

        // ─── 5. TERRAFORM — DEPLOIEMENT APP SUR EKS ─────────────────────────
        stage('Terraform Deploy App') {
            when {
                expression {
                    return env.GIT_BRANCH == 'origin/main' ||
                           env.GIT_BRANCH == 'origin/master' ||
                           env.BRANCH_NAME == 'main' ||
                           env.BRANCH_NAME == 'master'
                }
            }
            environment {
                AWS_ACCESS_KEY_ID     = "${AWS_CREDENTIALS_USR}"
                AWS_SECRET_ACCESS_KEY = "${AWS_CREDENTIALS_PSW}"
                TF_VAR_mongo_password = credentials('mongo-password')
                TF_VAR_backend_image_tag  = "${IMAGE_TAG}"
                TF_VAR_frontend_image_tag = "${IMAGE_TAG}"
            }
            steps {
                sh """
                    cd '${TF_DIR_APP}'

                    echo "=== Terraform Init ==="
                    terraform init -input=false

                    echo "=== Terraform Plan ==="
                    terraform plan -input=false -out=tfplan-app

                    echo "=== Terraform Apply ==="
                    terraform apply -input=false -auto-approve tfplan-app

                    echo "=== URL Frontend ==="
                    terraform output frontend_url
                """
            }
        }

    }

    post {
        always {
            sh """
                docker rmi ${env.BACKEND_IMAGE}:${env.IMAGE_TAG} 2>/dev/null || true
                docker rmi ${env.FRONTEND_IMAGE}:${env.IMAGE_TAG} 2>/dev/null || true
                docker image prune -f || true
            """
        }
        success {
            echo "Pipeline reussi - Build #${BUILD_NUMBER}"
            mail to: 'etablissementdinformatiqueacad@gmail.com',
                 subject: "[SUCCESS] Jenkins Build #${BUILD_NUMBER} - Portfolio K8S Terraform",
                 body: "Pipeline termine avec succes.\n\nBuild : #${BUILD_NUMBER}\nBranche : ${env.GIT_BRANCH ?: 'unknown'}\n\nVoir les logs : ${BUILD_URL}"
        }
        failure {
            echo "Pipeline echoue - Build #${BUILD_NUMBER}"
            mail to: 'etablissementdinformatiqueacad@gmail.com',
                 subject: "[FAILURE] Jenkins Build #${BUILD_NUMBER} - Portfolio K8S Terraform",
                 body: "Pipeline echoue.\n\nBuild : #${BUILD_NUMBER}\nBranche : ${env.GIT_BRANCH ?: 'unknown'}\n\nVoir les logs : ${BUILD_URL}"
        }
    }
}
