# Copier ce fichier en terraform.tfvars et remplir les valeurs
# Ne JAMAIS commiter terraform.tfvars dans git

aws_region   = "us-east-1"
environment  = "prod"
project_name = "portfolio"

# VPC
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]
availability_zones   = ["us-east-1a", "us-east-1b"]

# EKS
cluster_name       = "portfolio-eks"
kubernetes_version = "1.29"
node_instance_type = "t3.medium"
node_desired_size  = 2
node_min_size      = 1
node_max_size      = 3
node_disk_size     = 20

# Application
dockerhub_username = "aboubacryne"
backend_image_tag  = "latest"
frontend_image_tag = "latest"
k8s_namespace      = "portfolio"

# MongoDB (sensible — ne pas commiter)
mongo_username = "mongo"
mongo_password = "CHANGE_ME_STRONG_PASSWORD"
